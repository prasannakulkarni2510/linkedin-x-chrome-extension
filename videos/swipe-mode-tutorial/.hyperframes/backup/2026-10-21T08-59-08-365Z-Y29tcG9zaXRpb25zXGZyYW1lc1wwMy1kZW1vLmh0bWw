      </style>

      <div data-hf-id="hf-j1wo" id="root" data-composition-id="demo" data-width="1920" data-height="1080">
        <div data-hf-id="hf-40k5" id="demo-dots"></div>
        <div data-hf-id="hf-lqzl" id="demo-glow" data-layout-allow-overflow></div>

        <div data-hf-id="hf-1a7a" id="demo-top">
          <div data-hf-id="hf-zdro" id="demo-top-left">SWIPE MODE · HOW TO USE</div>
          <div data-hf-id="hf-ka57" id="demo-top-right">REAL RECORDING · MOCK FEED, FICTIONAL PEOPLE</div>
        </div>

        <div data-hf-id="hf-sohl" id="demo-window">
          <div data-hf-id="hf-cq5j" id="demo-chrome">
            <div data-hf-id="hf-rriv" class="demo-dot"></div>
            <div data-hf-id="hf-4rh3" class="demo-dot"></div>
            <div data-hf-id="hf-4d62" class="demo-dot"></div>
            <div data-hf-id="hf-xesw" id="demo-address">Your LinkedIn feed (demo)</div>
          </div>
          <video data-hf-id="hf-ax7q" id="demo-video" class="clip" src="assets/demo.mp4" muted playsinline data-start="0" data-duration="44" data-media-start="0" data-track-index="0"></video>
        </div>

        <div data-hf-id="hf-hcqp" id="demo-panel"></div>
        <div data-hf-id="hf-g98h" id="demo-rail"></div>
      </div>

      <script>
        // Step times come from assets/demo-cues.json (seconds into the recording, which starts with
        // this scene). Each step appears just before its key is pressed; each key presses on the
        // exact frame it was pressed in the recording.
        const STEPS = [
          { label: "START", title: "Start", at: 1.0, keys: [["Alt", "Shift", "S"]], join: [], press: [], body: "Click the floating Swipe Mode button, or press Alt+Shift+S." },
          { label: "READ", title: "Read", at: 5.1, keys: [["Space"], ["↓"]], join: ["or"], press: [[1, 5.9], [1, 6.6]], body: "One post fills the card. Long posts scroll inside it." },
          { label: "SKIP", title: "Skip", at: 8.1, keys: [["←"]], join: [], press: [[0, 8.9]], body: "Not for you? Left arrow, or swipe left. Next post." },
          { label: "UNDO", title: "Undo", at: 10.3, keys: [["U"]], join: [], press: [[0, 11.1]], body: "Skipped by mistake? U brings it right back." },
          { label: "ENGAGE", title: "Engage menu", at: 12.6, keys: [["→"]], join: [], press: [[0, 13.4]], body: "Right only opens your options. It never likes anything by itself." },
          { label: "REACT", title: "React", at: 16.1, keys: [["R"], ["2"]], join: ["then"], press: [[0, 16.9], [1, 18.6]], body: "Pick a reaction by its number. It goes through LinkedIn's own button.", result: ["✓ Reacted · Celebrate", 19.4] },
          { label: "COMMENT", title: "Comment", at: 21.5, keys: [["C"], ["Ctrl", "Enter"]], join: ["then"], press: [[0, 22.3], [1, 26.0]], body: "Type in the card. Ctrl+Enter posts it through LinkedIn's comment box.", result: ["✓ Comment posted", 26.7] },
          { label: "SAVE", title: "Save", at: 29.0, keys: [["S"]], join: [], press: [[0, 29.8]], body: "Save for later. Swipe Mode moves on once LinkedIn confirms.", result: ["✓ Saved", 30.4] },
          { label: "HELP", title: "Help", at: 32.9, keys: [["?"]], join: [], press: [[0, 33.7]], body: "Every shortcut for the screen you are on. Esc closes it." },
          { label: "SWIPE", title: "Trackpad", at: 37.1, keys: [["Swipe ←"]], join: [], press: [[0, 37.9]], body: "Two fingers left to skip, right to engage. One swipe, one post." },
          { label: "EXIT", title: "Exit", at: 40.1, keys: [["Esc"]], join: [], press: [[0, 40.9]], body: "Back to your feed, right where you started.", result: ["✓ Nothing kept after you exit", 41.6] },
        ];
        const D = 44;
        const pad = (n) => String(n).padStart(2, "0");

        const panel = document.getElementById("demo-panel");
        const rail = document.getElementById("demo-rail");
        const el = (tag, cls, text) => {
          const e = document.createElement(tag);
          if (cls) e.className = cls;
          if (text != null) e.textContent = text;
          return e;
        };

        STEPS.forEach((s, i) => {
          const block = el("div", "step");
          block.id = "demo-step-" + i;
          block.append(el("div", "step-num", pad(i + 1)), el("div", "step-of", "OF " + pad(STEPS.length)), el("div", "step-title", s.title));
          const keys = el("div", "step-keys");
          s.caps = [];
          s.keys.forEach((group, g) => {
            if (g > 0) keys.append(el("span", "cap-word", s.join[g - 1]));
            const groupCaps = [];
            group.forEach((k, j) => {
              if (j > 0) keys.append(el("span", "cap-join", "+"));
              const cap = el("span", "cap" + (k.length > 3 ? " cap-small" : ""), k);
              keys.append(cap);
              groupCaps.push(cap);
            });
            s.caps.push(groupCaps);
          });
          block.append(keys, el("div", "step-body", s.body));
          if (s.result) {
            const r = el("div", "step-result", s.result[0]);
            r.id = "demo-result-" + i;
            block.append(r);
          }
          panel.append(block);

          const seg = el("div", "rail-seg");
          const track = el("div", "rail-track");
          const fill = el("div", "rail-fill");
          fill.id = "demo-fill-" + i;
          track.append(fill);
          const label = el("div", "rail-label", s.label);
          label.id = "demo-label-" + i;
          seg.append(track, label);
          rail.append(seg);
        });

        const tl = gsap.timeline({ paused: true });

        // Ambient: dots drift across the whole scene, the panel glow breathes in 4 s cycles.
        tl.fromTo("#demo-dots", { x: 0, y: 0 }, { x: -44, y: -22, duration: D, ease: "none" }, 0);
        tl.fromTo("#demo-glow", { scale: 0.92 }, { scale: 1.06, duration: 4, ease: "sine.inOut", yoyo: true, repeat: Math.max(0, Math.floor(D / 4) - 1) }, 0);

        // The browser window lands first.
        tl.fromTo("#demo-window", { opacity: 0, y: 40, scale: 0.97 }, { opacity: 1, y: 0, scale: 1, duration: 0.6, ease: "power3.out" }, 0);
        tl.fromTo("#demo-top", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "power1.out" }, 0.1);
        tl.fromTo("#demo-rail", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 0.3);

        function pressCaps(caps, t) {
          caps.forEach((cap) => {
            // Press-release spring: linear press, spring release, color flash on the same trigger.
            tl.to(cap, { scale: 0.9, y: 6, boxShadow: "0 2px 0 #13201d", duration: 0.1, ease: "power1.in" }, t);
            tl.to(cap, { scale: 1, y: 0, boxShadow: "0 8px 0 #13201d", duration: 0.5, ease: "back.out(2)" }, t + 0.1);
            tl.to(cap, { backgroundColor: "#f5b83d", duration: 0.08, ease: "none" }, t);
            tl.to(cap, { backgroundColor: "#ffffff", duration: 0.25, ease: "power1.out" }, t + 0.3);
          });
        }

        STEPS.forEach((s, i) => {
          const sel = "#demo-step-" + i;
          const next = STEPS[i + 1];
          tl.fromTo(sel, { opacity: 0, y: 28 }, { opacity: 1, y: 0, duration: 0.4, ease: "power3.out" }, s.at);
          tl.fromTo(sel + " .cap", { scale: 0.6, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.45, ease: "back.out(2.2)", stagger: 0.06 }, s.at + 0.12);
          if (next) tl.to(sel, { opacity: 0, y: -18, duration: 0.25, ease: "power2.in" }, next.at - 0.28);
          s.press.forEach(([group, t]) => pressCaps(s.caps[group], t));
          if (s.result) tl.fromTo("#demo-result-" + i, { opacity: 0, scale: 0.8 }, { opacity: 1, scale: 1, duration: 0.4, ease: "back.out(2)" }, s.result[1]);

          tl.fromTo("#demo-fill-" + i, { scaleX: 0 }, { scaleX: 1, duration: 0.45, ease: "power2.out" }, s.at);
          tl.fromTo("#demo-label-" + i, { color: "#4b5b57" }, { color: "#0f766e", duration: 0.3, ease: "none" }, s.at);
        });

        window.__timelines["demo"] = tl;
      </script>
    </template>
